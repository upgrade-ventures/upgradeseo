{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upgradeseo",
  "main": "src/server.ts",
  // Mounted under the marketing site rather than its own hostname. The trailing
  // * is required: without it only the exact path matches and every asset and
  // API call below it falls through to Ghost.
  "routes": [
    {
      "pattern": "upgrade.ventures/UpgradeSEO*",
      "zone_name": "upgrade.ventures",
    },
  ],
  // Explicit, never inferred. The fallback for an unset value is
  // "cloudflare_access", but "local_noauth" disables authentication entirely,
  // so the mode that gates every request is stated rather than defaulted.
  "vars": { "AUTH_MODE": "hosted", "BYPASS_EMAIL_VERIFICATION": "true" },
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    // Spans are billed as observability events (free tier 200k/day); add a
    // traces head_sampling_rate below 1 if span volume becomes a cost concern.
    "traces": {
      "enabled": true,
    },
  },
  // Smart Placement relocates only the `fetch` handler (cron + Workflow runs
  // stay at the edge) toward external subrequests — Postgres via Hyperdrive,
  // SEO APIs — not D1/KV/R2 bindings, so it's a DB no-op on the D1 default.
  // Must live here: a dashboard-only toggle is wiped by `wrangler deploy`.
  "placement": {
    "mode": "smart",
  },
  "workflows": [
    {
      "name": "site-audit-workflow",
      "binding": "SITE_AUDIT_WORKFLOW",
      "class_name": "SiteAuditWorkflow",
    },
    {
      "name": "rank-check-workflow",
      "binding": "RANK_CHECK_WORKFLOW",
      "class_name": "RankCheckWorkflow",
    },
  ],
  // Durable Object backing the onboarding strategy chat (Agents SDK
  // AIChatAgent). One instance per project; messages persist in the DO's
  // SQLite. SQLite-backed classes must be declared in `migrations` below for
  // the wrangler/workerd surfaces (local dev, Docker self-host); Alchemy
  // deploys derive SQLite backing on their own.
  "durable_objects": {
    "bindings": [
      // Per-audit crawl scratchpad: frontier, link edges, and a slim page
      // mirror in the DO's SQLite. Destroyed at finalize; self-cleans via
      // alarm if the audit dies.
      {
        "name": "AUDIT_SCRATCHPAD",
        "class_name": "AuditScratchpad",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OnboardingChatAgent"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SamChatAgent"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AuditScratchpad"],
    },
    // The SAM chat surface was removed from the product. Dropping the binding
    // alone leaves workerd/Cloudflare with a class that no longer exists in the
    // bundle, which fails the deploy — the class has to be deleted through a
    // migration, which also discards its stored SQLite transcripts.
    {
      "tag": "v4",
      "deleted_classes": ["SamChatAgent"],
    },
    // The onboarding strategy chat went the same way: the design has no chat
    // surface, so its Durable Object has to be deleted through a migration
    // rather than merely unbound, which also discards its stored transcripts.
    {
      "tag": "v5",
      "deleted_classes": ["OnboardingChatAgent"],
    },
  ],
  "triggers": {
    // Every 5 min: rank checks + stale-audit reconcile. Daily: OAuth KV GC.
    // Dispatched on controller.cron in src/server.ts `scheduled`.
    //
    // ⚠️ ACCOUNT CAP, not a config error. Workers Free allows 5 cron triggers
    // PER ACCOUNT, across every worker. Once that is reached the deploy fails
    // on PUT .../schedules and wrangler reports only "A request to the
    // Cloudflare API failed" / "non-user error" — it never surfaces the limit,
    // and the failure is identical for one cron or two, so it reads like a
    // broken schedule rather than a quota. Only the dashboard states the real
    // reason. If schedules stop deploying, check the account cron count before
    // touching anything here.
    //
    // The daily entry is a no-op outside hosted auth mode: `scheduled` gates it
    // on isHostedAuthMode(), so a cloudflare_access deploy that is short on
    // slots should register the 5-minute one first.
    "crons": ["*/5 * * * *", "17 3 * * *"],
  },
  // This config serves local dev and Docker self-host only. All Cloudflare
  // deployments — previews, prod, self-host — go through Alchemy
  // (alchemy.run.ts), which provisions real resources per stage and never
  // reads these ids.
  //
  // The ids below are NOT dead config: miniflare derives its on-disk storage
  // filenames (.wrangler/state, a persistent volume in Docker self-hosts)
  // from an HMAC of `id`/`database_id`. Changing them orphans every existing
  // local and self-hosted database. Leave them as-is.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "ceaa1d0011c9461f9b619ecfc329e575",
    },
    {
      "binding": "OAUTH_KV",
      "id": "88a50a640a0e4dc1b8e845fba7274c0c",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upgradeseo",
      "database_id": "918c71a0-c91b-4917-99b7-8b652fea7748",
      "migrations_dir": "drizzle",
    },
  ],
  // Postgres scale path (opt-in; D1 is the default). Hyperdrive is the ONLY way
  // the app connects to Postgres — there is no direct-connection fallback. For
  // local dev, `localConnectionString` is the throwaway Docker Postgres from
  // docs/LOCAL_POSTGRES.md, and nothing connects to it unless
  // DATABASE_PROVIDER=postgres is set in .env.local.
  //
  // Kept commented out: the id lives in UpgradeSEO's account, and only local
  // Postgres dev reads this block (Alchemy deploys and the Docker image never
  // do). Uncomment when running local Postgres dev per docs/LOCAL_POSTGRES.md.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "9d64ccfb559f44449ce52a143912f898",
  //     "localConnectionString": "postgres://upgradeseo:upgradeseo@localhost:5433/upgradeseo",
  //   },
  // ],
  "r2_buckets": [
    {
      "bucket_name": "upgradeseo",
      "binding": "R2",
    },
  ],
}
